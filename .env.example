# =============================================================================
# SecureSight — Environment Configuration
# Copy to .env and adjust for your environment.
# NEVER commit a populated .env — only this template belongs in git.
# =============================================================================

# ----------------------------- Application ---------------------------------
APP_NAME=SecureSight
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# --------------------------------- API --------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ----------------------------- Database (PG 15+) ---------------------------
# Async URL is used by the API at runtime.
# Sync URL is used by Alembic migrations.
DATABASE_URL=postgresql+asyncpg://securesight:securesight@postgres:5432/securesight
DATABASE_URL_SYNC=postgresql+psycopg2://securesight:securesight@postgres:5432/securesight
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ------------------- Redis (Cache + Queue + Pub/Sub) -----------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----------------------------- JWT (RS256) ----------------------------------
# Generate with:
#   openssl genrsa -out jwt_private.pem 4096
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem

# ----------------------------- Password Hashing ----------------------------
BCRYPT_ROUNDS=12

# ----------------------------- Prometheus -----------------------------------
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_TIMEOUT=10

# ----------------------------- Grafana --------------------------------------
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_OAUTH_ENABLED=false

# ----------------------------- Alertmanager ---------------------------------
ALERTMANAGER_URL=http://alertmanager:9093

# ----------------------------- SMTP (Email) ---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=securesight-alerts@example.com
SMTP_USE_TLS=true

# ----------------------------- Slack ----------------------------------------
SLACK_WEBHOOK_URL=

# ----------------------------- Microsoft Teams ------------------------------
TEAMS_WEBHOOK_URL=

# ----------------------------- Telegram -------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------- PagerDuty ------------------------------------
PAGERDUTY_INTEGRATION_KEY=

# ----------------------------- Webhook --------------------------------------
WEBHOOK_URL=

# ----------------------------- Anomaly Detection ----------------------------
ANOMALY_CONFIDENCE_THRESHOLD=0.8
ANOMALY_WINDOW_HOURS=24
ANOMALY_TRAINING_DAYS=7
ANOMALY_SCAN_INTERVAL_MINUTES=5
ANOMALY_MIN_DATA_POINTS=100

# ML algorithm ensemble weights (sum to 1.0)
ML_WEIGHT_ISOLATION_FOREST=0.35
ML_WEIGHT_ARIMA=0.20
ML_WEIGHT_PROPHET=0.20
ML_WEIGHT_ZSCORE=0.15
ML_WEIGHT_EMA=0.10

# ----------------------------- Rate Limiting --------------------------------
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------- Cache TTL ------------------------------------
CACHE_METRICS_TTL_SECONDS=30
CACHE_SESSION_TTL_SECONDS=1800

# ----------------------------- Pagination -----------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --------------------- Self-Monitoring Thresholds --------------------------
API_REQUEST_DURATION_WARN_MS=500
API_REQUEST_DURATION_CRIT_MS=2000
API_ERROR_RATE_WARN=0.01
API_ERROR_RATE_CRIT=0.05
CELERY_TASK_RUNTIME_WARN_SECONDS=120

# --------------------- Maintenance / Retention -----------------------------
MAINTENANCE_RETENTION_DAYS=30
